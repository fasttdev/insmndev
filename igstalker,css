.ig{position:relative;background:#fff;border:1px solid var(--line);border-radius:22px;padding:32px;box-shadow:var(--shadow-card);max-width:760px;margin:0 auto}
.ig__head{display:flex;align-items:center;gap:14px;margin-bottom:24px}
.ig__mark{display:flex;align-items:center;justify-content:center;width:48px;height:48px;border-radius:14px;background:linear-gradient(135deg,#f09433,#dc2743,#bc1888);color:#fff;box-shadow:0 10px 22px -10px rgba(220,39,67,.6)}
.ig__kicker{font-size:11px;font-weight:800;text-transform:uppercase;color:var(--blue-600);margin-bottom:2px}
.ig__title{font-size:22px;font-weight:800;color:var(--ink)}.ig__title em{color:var(--blue-600)}
.ig__form{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}
.ig__control{position:relative;flex:1 1 320px;display:flex;align-items:center;background:#fff;border:1.5px solid var(--line);border-radius:14px;transition:border-color .18s}
.ig__control:focus-within{border-color:#dc2743;box-shadow:0 0 0 4px rgba(220,39,67,.1)}
.ig__control-icon{position:absolute;left:14px;color:var(--muted)}.ig__control:focus-within .ig__control-icon{color:#dc2743}
.ig__input{flex:1;padding:14px 20px 14px 42px;font-size:14.5px;border:none;outline:none;background:transparent;border-radius:14px}
.ig__submit{display:inline-flex;align-items:center;justify-content:center;gap:9px;font-size:15px;font-weight:800;color:#fff;background:linear-gradient(135deg,#f09433,#dc2743,#bc1888);padding:14px 32px;border:none;border-radius:14px;box-shadow:0 10px 24px -10px rgba(220,39,67,.6);cursor:pointer}
.ig__submit:disabled{opacity:.7}
.ig__spinner{width:16px;height:16px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:spin .75s linear infinite}
.ig__hint{font-size:12px;color:var(--muted);margin-bottom:20px}
.ig__status{display:flex;align-items:center;gap:9px;padding:13px 16px;font-size:13.5px;border-radius:12px;margin-bottom:20px;border:1px solid var(--line);background:var(--blue-50)}
.ig__status.is-loading svg{animation:spin .9s linear infinite}
.ig__status.is-error{color:var(--err);background:var(--err-bg);border-color:var(--err-line)}
.igprof{border:1px solid var(--line);border-radius:16px;background:#fff;overflow:hidden}
.igprof__top{display:flex;gap:16px;padding:20px;background:linear-gradient(180deg,#fff,var(--blue-50));border-bottom:1px solid var(--line)}
.igprof__avatar{width:88px;height:88px;border-radius:50%;overflow:hidden;border:3px solid #fff;box-shadow:0 8px 22px -8px rgba(220,39,67,.4)}
.igprof__avatar img{width:100%;height:100%;object-fit:cover}
.igprof__name{font-size:17px;font-weight:800;display:flex;align-items:center;gap:6px;margin-bottom:2px}
.igprof__verified{width:16px;height:16px;background:#0ea5e9;border-radius:50%;color:#fff;display:flex;align-items:center;justify-content:center}
.igprof__username{font-size:13px;font-weight:700;color:#dc2743;margin-bottom:8px}
.igprof__bio{font-size:12.5px;line-height:1.55;color:var(--ink-2);white-space:pre-line}
.igprof__stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line)}
.igprof__stat{background:#fff;padding:14px 10px;text-align:center}
.igprof__stat b{display:block;font-size:16px;font-weight:800;color:var(--ink)}
.igprof__stat span{font-size:10px;font-weight:800;color:var(--muted);text-transform:uppercase}
.igprof__meta{padding:14px 20px;display:flex;flex-wrap:wrap;gap:8px;border-top:1px solid var(--line)}
.igprof__tag{font-size:11.5px;font-weight:700;padding:5px 11px;border-radius:99px;border:1px solid var(--line);color:var(--ink-2);background:#fafcff;text-decoration:none}
.igprof__tag--ok{color:#047857;background:#ecfdf5;border-color:#d1fae5}
.igprof__tag--off{color:var(--muted);background:#f1f5f9;border-color:#e2e8f0}
@media (max-width:640px){.ig{padding:20px}.igprof__top{padding:16px;flex-direction:column;align-items:center;text-align:center}}